        <mxCell id="n_ci_stmt3" value="Stmt ManageOnlyThisWorkloadsResources &#8212; ec2:Describe*, rds:Describe*/ModifyDBInstance, s3:GetBucket*/PutBucket* &#8212; Condition: aws:ResourceTag/workload-id = web-app-db" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
