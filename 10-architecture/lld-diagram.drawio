        </mxCell>
        <mxCell id="n_ci_role" value="aws_iam_role.ci_pipeline&lt;br&gt;(OIDC-federated, tag-scoped &#8212; no standing credential)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="460" height="50" as="geometry" />
