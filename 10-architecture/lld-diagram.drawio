        </mxCell>
        <mxCell id="n_note_nossh" value="No SSH/RDP path to any instance &#8212; admin access (if ever needed) via AWS Systems Manager Session Manager only, itself logged to CloudTrail. Closes F-14 permanently, not just a tighter CIDR." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;fontStyle=2;align=left;spacingLeft=8;" vertex="1" parent="1">
