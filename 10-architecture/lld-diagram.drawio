        <mxCell id="n_title" value="Low-Level Design &#8212; web-app-db Workload Slice (ingress &#8594; app &#8594; database, + the CI/CD path that provisions it)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
