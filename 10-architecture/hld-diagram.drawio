        </mxCell>
        <mxCell id="n_g1" value="1  Gitleaks &#8212; full-history secrets scan (hard-fail on match)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
