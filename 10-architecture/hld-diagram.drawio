        </mxCell>
        <mxCell id="n_g3" value="3  Trivy &#8212; SCA / container CVEs / SBOM (CycloneDX)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
